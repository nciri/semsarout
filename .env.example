# Variables d'environnement locales (dev). Copier en `.env` (gitignoré) et renseigner.
# Aucune valeur réelle ici — jamais de secret committé.

# Clé de signature des JWT (HS256), partagée identity/BFF. Générer : openssl rand -hex 32
JWT_SECRET_KEY=

# Jeton interne inter-services (optionnel en dev, défaut non sensible dans les scripts)
INTERNAL_TOKEN=
