# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/semsar_dev

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Celery/Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# StayManager Integration (Partner API v1 — no api.staymanager.ma subdomain,
# everything lives under staymanager.ma/api/v1). Per-agency API keys are stored
# in the database (created by each agency from StayManager > Integrations & API),
# there is no global key here.
STAYMANAGER_API_URL=https://staymanager.ma/api/v1

# Public https:// base URL of this deployment, used to build the webhook
# callback URL registered with StayManager at connection time. Must resolve to
# a public IP (StayManager rejects localhost/private ranges) — use an ngrok/
# cloudflared tunnel URL in local development, leave unset to skip webhook
# registration (falls back to manual "Synchroniser" only).
APP_BASE_URL=https://your-public-domain.example
