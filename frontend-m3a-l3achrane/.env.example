# Variables du frontend m3a-l3achrane (Vite). Copier en `.env` (gitignoré).
# Rappel : tout ce qui est préfixé VITE_ finit dans le bundle — jamais de secret ici.

# Servir des données simulées au lieu d'appeler l'API (démonstration, développement isolé).
VITE_USE_MOCK=false

# Domaines pour lesquels la simulation est active, séparés par des virgules.
VITE_MOCK_DOMAINS=
