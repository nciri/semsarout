# Variables du frontend SemsarOut (Vite). Copier en `.env` (gitignoré).
# Préfixe VITE_ obligatoire : sans lui, Vite n'expose pas la variable au navigateur.
# Rappel : tout ce qui est préfixé VITE_ finit dans le bundle — jamais de secret ici.

# Base de l'API (BFF). Vide en dev : le proxy Vite renvoie vers la passerelle locale.
VITE_API_URL=
