# BFF/gateway — copier en gateway/.env
UPSTREAM_URL=http://localhost:7000
OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO
# Frontière d'auth SÉVRÉE : le BFF valide le JWT localement. Le secret DOIT correspondre
# à JWT_SECRET_KEY du monolithe (émetteur des jetons). Les jetons enrichis (claims d'identité)
# sont résolus 100 % localement ; les anciens jetons retombent sur /auth/me (transition).
JWT_SECRET_KEY=PURGED-DEV-SECRET
JWT_ALGORITHM=HS256
# GEO_URL=http://localhost:8509          # price-position + /market/neighborhood-prices
# MESSAGING_URL=http://localhost:8510    # messages acheteur (/buyer/messages*)
# TRUST_SAFETY_URL=http://localhost:8511 # suspend/unsuspend comptes (/admin/accounts/*)
# Routage strangler : décommenter quand un service tourne
# IDENTITY_URL=http://localhost:8001
# SEARCH_URL=http://localhost:8003
# ANALYTICS_URL=http://localhost:8004
# CONTRACT_URL=http://localhost:8005
# LEGAL_URL=http://localhost:8006
# PAYMENT_URL=http://localhost:8007
# BILLING_URL=http://localhost:8008
# CATALOG_URL=http://localhost:8009      # reroute produits (/backoffice/shop/products, /admin/products)
# MARKETPLACE_URL=http://localhost:8010  # reroute panier/commandes (/backoffice/shop/cart|orders, /admin/orders)
# DIRECTORY_URL=http://localhost:8011    # reroute artisans/travaux (/backoffice/artisans|work-orders|artisan-trades, /admin/shared-artisans)
# LISTING_URL=http://localhost:8012      # Stage 1 : détail/CRUD/publish biens + /my-properties (PAS la découverte)
# CRM_URL=http://localhost:8013          # Stage A : leads (/backoffice/leads*)
