# BFF/gateway — copier en gateway/.env
UPSTREAM_URL=http://localhost:7000
OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO
# Frontière d'auth SÉVRÉE : le BFF valide le JWT localement SI cette clé est fournie.
# Elle DOIT correspondre EXACTEMENT à JWT_SECRET_KEY du monolithe (émetteur des jetons).
# Ne jamais committer la vraie valeur : la mettre dans gateway/.env (gitignoré). Vide/absent
# → le BFF retombe sur /auth/me du monolithe (aucune vérification avec une clé codée en dur).
JWT_SECRET_KEY=change-me-must-match-monolith-JWT_SECRET_KEY
JWT_ALGORITHM=HS256
# GEO_URL=http://localhost:8509          # price-position + /market/neighborhood-prices
# MESSAGING_URL=http://localhost:8510    # messages acheteur (/buyer/messages*)
# TRUST_SAFETY_URL=http://localhost:8511 # suspend/unsuspend comptes (/admin/accounts/*)
# Routage strangler : décommenter quand un service tourne
