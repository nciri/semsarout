## /etc/semsar/secrets.env — généré par Ansible (rôle base), root-only (0600).
## Fichier EnvironmentFile commun à toutes les units systemd du mesh (services,
## relais, workers) + Traefik/nginx si besoin. Format shell-env strict (KEY=VALUE,
## une entrée par ligne, pas d'expansion ${...} : systemd ne l'interprète pas).
##
## Régénéré UNIQUEMENT si absent (cf. roles/base/tasks/main.yml) : rejouer le
## playbook ne casse jamais un mot de passe déjà attribué à un rôle PostgreSQL.

# --- Mots de passe PostgreSQL (un par rôle/service, cf. semsar_db_roles) ---
{% for role in semsar_db_roles %}
PG_PASSWORD_{{ role | upper }}={{ semsar_generated_secrets[role] }}
{% endfor %}

# --- Infra ---
# RABBITMQ_USER/PASS et MINIO_USER/PASSWORD : consommées telles quelles par
# `docker compose --env-file` (cf. infra/docker-compose.yml, roles/docker_infra) —
# mêmes noms de variable que le compose (${RABBITMQ_USER:-semsar}, etc).
RABBITMQ_USER=semsar
RABBITMQ_PASS={{ semsar_rabbitmq_pass }}
RABBITMQ_URL=amqp://semsar:{{ semsar_rabbitmq_pass }}@localhost:5672/
EVENTS_EXCHANGE=semsar.events
OPENSEARCH_URL=http://localhost:9200
MONOLITH_URL=http://localhost:7000
INTERNAL_TOKEN={{ semsar_internal_token }}
JWT_SECRET_KEY={{ jwt_secret_key }}

# --- Stockage objet (MinIO/S3) ---
MINIO_USER=semsar
MINIO_PASSWORD={{ semsar_minio_password }}
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=semsar
S3_SECRET_KEY={{ semsar_minio_password }}
AWS_ACCESS_KEY_ID=semsar
AWS_SECRET_ACCESS_KEY={{ semsar_minio_password }}
MEDIA_BUCKET=semsar-media
RENTAL_DOCS_BUCKET=semsar-rental-docs
WORM_BUCKET=semsar-worm

# --- Masquage trust-safety (listing, search) ---
MODERATION_HIDDEN_URL=http://localhost:8511/internal/moderation/hidden

# --- Signature électronique 3a9dSign (rental, selling) — vide en attendant la clé
# réelle : la fonctionnalité de signature reste indisponible tant qu'elle n'est pas
# renseignée manuellement (jamais commitée), le reste du service fonctionne. ---
SIGN_API_URL=
SIGN_API_KEY=

# --- Multi-tenant / environnement (lus par le gateway uniquement, cf. gateway/app/config.py) ---
ENVIRONMENT=prod
TENANT_HOSTS={{ m3a_l3achrane_domain }}=m3a-l3achrane,www.{{ m3a_l3achrane_domain }}=m3a-l3achrane

