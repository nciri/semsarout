[Unit]
Description=SemsarOut — ordonnanceur notification (rappels temporels)
After=network.target postgresql.service semsar-app@notification.service
Requires=postgresql.service

[Service]
Type=simple
User={{ semsar_user }}
Group={{ semsar_group }}
WorkingDirectory={{ semsar_app_dir }}/services/notification
EnvironmentFile={{ semsar_secrets_file }}
EnvironmentFile={{ semsar_env_dir }}/notification-scheduler.env
ExecStart={{ semsar_venv_dir }}/bin/python -m app.scheduler
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
