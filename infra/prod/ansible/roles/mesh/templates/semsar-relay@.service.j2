[Unit]
Description=SemsarOut — relay outbox %i
After=network.target postgresql.service semsar-app@%i.service
Requires=postgresql.service

[Service]
Type=simple
User={{ semsar_user }}
Group={{ semsar_group }}
WorkingDirectory={{ semsar_app_dir }}/services/%i
EnvironmentFile={{ semsar_secrets_file }}
EnvironmentFile={{ semsar_env_dir }}/relay-%i.env
ExecStart={{ semsar_venv_dir }}/bin/python -m app.relay
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
