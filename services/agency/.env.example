SERVICE_NAME=agency
DATABASE_URL=postgresql+psycopg://agency:agency@localhost:5432/semsar
RABBITMQ_URL=amqp://semsar:semsar@localhost:5672/
EVENTS_EXCHANGE=semsar.events
TRUST_GATEWAY_HEADERS=true
# Membres de l'agence (/my-agency) via l'endpoint interne d'identity ;
# biens de l'agence (/agencies/{slug}/properties) via l'endpoint interne de listing
IDENTITY_URL=http://localhost:8501
LISTING_URL=http://localhost:8012
INTERNAL_TOKEN=change-me-internal
OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO
