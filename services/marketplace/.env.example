SERVICE_NAME=marketplace
DATABASE_URL=postgresql+psycopg://marketplace:marketplace@localhost:5432/semsar
RABBITMQ_URL=amqp://semsar:semsar@localhost:5672/
EVENTS_EXCHANGE=semsar.events
# Transition : faire confiance à l'identité injectée par le BFF (X-Semsar-*)
TRUST_GATEWAY_HEADERS=true
# Appel interne vers catalog (réservation de stock au paiement)
CATALOG_INTERNAL_URL=http://localhost:8009
INTERNAL_TOKEN=change-me-internal
OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO
