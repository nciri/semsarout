SERVICE_NAME=notification
DATABASE_URL=postgresql+psycopg://notification:notification@localhost:5432/semsar
RABBITMQ_URL=amqp://semsar:semsar@localhost:5672/
EVENTS_EXCHANGE=semsar.events
OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO

# --- Email (SMTP) — ex. Brevo. Renseigner dans .env (gitignored), JAMAIS ici. ---
# Brevo : SMTP & API → onglet SMTP. Le compte/expéditeur doit être VALIDÉ côté Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre-login-brevo@example.com
SMTP_PASSWORD=xsmtpsib-...            # clé SMTP Brevo (pas la clé API xkeysib-)
SMTP_FROM=expediteur-verifie@example.com
SMTP_FROM_NAME=SemsarOut
